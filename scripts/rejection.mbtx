///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}

///|
/// Run the local rejection recorder, which shares unpublished tooling helpers
/// with the parity and rejection checks. Run this script from the repository root.
async fn main {
  let args = ["run", "-q", "--target", "wasm", "tests/rejection_record", "--"]
  args.append(@env.args()[1:].to_owned())
  @sys.exit(@process.run("moon", args))
}
