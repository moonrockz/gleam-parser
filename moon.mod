name = "moonrockz/gleam-parser"

version = "0.5.0"

import {
  "moonrockz/expect@0.6.1",
  "moonbit-community/toml@0.5.0",
  "moonbitlang/x@0.5.5",
  "moonrockz/pretty@0.2.0",
}

readme = "README.mbt.md"

repository = "https://github.com/moonrockz/gleam-parser"

license = "Apache-2.0"

keywords = [ "gleam", "parser", "scanner", "ast", "morphir" ]

description = "Parser and parsing utilities for the Gleam programming language in MoonBit"

source = "src"

warnings = "-implicit_impl_as_method"
